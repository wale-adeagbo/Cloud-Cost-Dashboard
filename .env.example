# --- Optional: disable providers you do not use ---
# DISABLE_AWS=true
# DISABLE_AZURE=true
# DISABLE_GCP=true

# AWS: Cost Explorer (API only in us-east-1; SDK uses default credential chain)
# AWS_PROFILE=your-profile
# AWS_REGION=us-east-1

# Azure: subscription + DefaultAzureCredential (env vars, managed identity, or Azure CLI)
# AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# GCP: project + Application Default Credentials
# GCP_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Optional: override default idle recommender
# GCP_IDLE_RECOMMENDER=google.compute.instance.IdleResourceRecommender

# Heuristic anomaly threshold (daily vs 5-day trailing mean)
# SPEND_ANOMALY_MULTIPLIER=1.6
